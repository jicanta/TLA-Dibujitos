// Comprehensive test of all mathematical functions

// Test basic constants
pi = 3.14159265359;
e = 2.71828182846;
test_angle = pi / 4.; // 45 degrees
test_value = 16.;

log "Testing Mathematical Functions\n";
log "================================\n";
log "PI: {pi}\n";
log "E: {e}\n";
log "Test angle (45°): {test_angle}\n";
log "Test value: {test_value}\n\n";

// Test square root
sqrt_result = sqrt(test_value/1.);
log "sqrt({test_value}) = {sqrt_result}\n";

// Test trigonometric functions
cos_result = cos(test_angle);
sin_result = sin(test_angle);
tan_result = tan(test_angle);
log "cos({test_angle}) = {cos_result}\n";
log "sin({test_angle}) = {sin_result}\n";
log "tan({test_angle}) = {tan_result}\n";

// Test absolute value
abs_positive = abs(5.5);
abs_negative = abs(-5.5);
log "abs(5.5) = {abs_positive}\n";
log "abs(-5.5) = {abs_negative}\n";

// Test natural logarithm
log_result = logf(e);
log_result2 = logf(10.);
log "logf({e}) = {log_result}\n";
log "logf(10.0) = {log_result2}\n";

// Test power function
pow_result = powf(2., 3.);
pow_result2 = powf(test_value, 0.5);
log "powf(2.0, 3.0) = {pow_result}\n";
log "powf({test_value}, 0.5) = {pow_result2}\n";

// Test rounding
round_up = roundf(3.7);
round_down = roundf(3.2);
round_half = roundf(3.5);
log "roundf(3.7) = {round_up}\n";
log "roundf(3.2) = {round_down}\n";
log "roundf(3.5) = {round_half}\n";

log "\nVisual representation of functions:\n";

// Visual representation using circles and colors
stroke(BLACK);
fill(RED);

// Draw a circle for each function result scaled appropriately
base_x = 0.;
base_y = 0.;
spacing = 60.;

// sqrt visualization
fill(RED);
circle((base_x, base_y), sqrt_result * 2.);
log "Red circle: sqrt result radius\n";

// cos/sin visualization  
fill(GREEN);
circle((base_x + spacing, base_y), abs(cos_result) * 20.);
log "Green circle: cos result scaled\n";

fill(BLUE);
circle((base_x + spacing * 2., base_y), abs(sin_result) * 20.);
log "Blue circle: sin result scaled\n";

// Power function visualization
fill(YELLOW);
circle((base_x, base_y + spacing), pow_result * 3.);
log "Yellow circle: power result scaled\n";

// Logarithm visualization
fill(PURPLE);
circle((base_x + spacing, base_y + spacing), abs(log_result2) * 8.);
log "Purple circle: log result scaled\n";

// Rounded values as polygon sides simulation
fill(ORANGE);
sides = roundf(round_up);
log "Orange shapes based on rounded values\n";

// Create simple patterns based on math results
for i in [1:5] {
    angle = i * pi / 3.;
    x_pos = cos(angle) * 40.;
    y_pos = sin(angle) * 40.;
    radius = sqrt(i/1.) * 3.;
    
    fill(i * 1000000); // Different colors
    circle((x_pos, y_pos + spacing * 2.), radius);
}

log "Trigonometric circle pattern created\n";
log "Test completed successfully!\n";
